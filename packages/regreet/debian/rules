#!/usr/bin/make -f
# regreet: single Rust crate (GTK 4), vendored offline build.

# Compile-time paths (see upstream README). The defaults match Debian except
# the power commands, which go through logind.
export GREETD_CONFIG_DIR = /etc/greetd
export STATE_DIR = /var/lib/regreet
export LOG_DIR = /var/log/regreet
export SESSION_DIRS = /usr/share/wayland-sessions:/usr/share/xsessions
export REBOOT_CMD = systemctl reboot
export POWEROFF_CMD = systemctl poweroff

export RUSTC = /usr/bin/rustc
export RUSTDOC = /usr/bin/rustdoc
export CARGO = /usr/bin/cargo

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	@if [ -d vendor ]; then \
		python3 debian/sanitize-vendor-checksums.py; \
	fi
	$(CARGO) build --release --jobs $(shell nproc) --frozen --offline --locked

override_dh_auto_install:
	@echo "Skipping cargo install"
