#!/bin/sh
# The greeter runs as "greeter" (upstream's account; the polkit rule and the
# configs name it). video/render reach the GPU, input the seat, as upstream.
# /etc/greetd/config.toml belongs to the admin and is never touched.
set -e
if [ "$1" = configure ]; then
    if ! getent passwd greeter >/dev/null; then
        adduser --quiet --system --group --home /var/lib/greeter \
            --no-create-home --shell /usr/sbin/nologin greeter
    fi
    for g in video render input; do
        if getent group "$g" >/dev/null; then
            adduser --quiet greeter "$g" >/dev/null
        fi
    done
fi
#DEBHELPER#
